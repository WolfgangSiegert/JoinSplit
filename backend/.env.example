APP_NAME=JoinSplit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
JOIN_SPLIT_CLIENT_ORIGIN=http://127.0.0.1:3000
APP_LOCALE=de
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local Homebrew cluster only. Keep passwords out of version control.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=joinsplit_dev
DB_USERNAME=joinsplit_dev
DB_PASSWORD=
DB_SSLMODE=prefer
DB_SSLROOTCERT=

# Production-only deployment guard. App Platform sets this at runtime after
# all secrets and the private PostgreSQL connection are available.
JOIN_SPLIT_VALIDATE_PRODUCTION=false
TRUSTED_PROXIES=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
