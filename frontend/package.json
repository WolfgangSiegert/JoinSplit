{
  "name": "joinsplit-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.10.5",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "nuxt preview --host 127.0.0.1",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p tsconfig.tests.json",
    "test:e2e": "playwright test",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.1",
    "@pinia/nuxt": "^1.0.2",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
