{
  "name": "joinsplit-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.10.5",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "build:native": "JOIN_SPLIT_NATIVE_BUILD=true NUXT_PUBLIC_API_BASE=https://joinsplit.tiny-bits.org nuxt generate && node scripts/verify-native-build.mjs",
    "native:copy": "pnpm build:native && cap copy",
    "native:assets": "node scripts/generate-native-assets.mjs",
    "native:sync": "pnpm build:native && pnpm native:assets && cap sync",
    "native:verify:android": "node scripts/verify-android-runtime.mjs",
    "native:verify:android-lifecycle": "node scripts/verify-android-lifecycle.mjs",
    "native:open:android": "cap open android",
    "native:open:ios": "cap open ios",
    "preview": "nuxt preview --host 127.0.0.1",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p tsconfig.tests.json",
    "test:e2e": "playwright test",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@nuxt/ui": "^4.11.1",
    "@pinia/nuxt": "^1.0.2",
    "idb": "^8.0.3",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@vite-pwa/nuxt": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
