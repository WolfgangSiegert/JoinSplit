  "fifoVectors": [
    {
      "name": "settlement lifecycle remains ordered",
      "mutations": [
        { "type": "CreateSettlement", "createdOrder": 10 },
        { "type": "UpdateSettlement", "createdOrder": 11 },
        { "type": "DeleteSettlement", "createdOrder": 12 }
      ],
      "expectedTypeOrder": ["CreateSettlement", "UpdateSettlement", "DeleteSettlement"]
    },
    {
      "name": "expense precedes settlement based on its balances",
      "mutations": [
        { "type": "CreateExpense", "createdOrder": 20 },
        { "type": "CreateSettlement", "createdOrder": 21 }
      ],
      "expectedTypeOrder": ["CreateExpense", "CreateSettlement"]
    },
    {
      "name": "participant deactivation precedes strict settlement validation",
      "mutations": [
        { "type": "DeactivateParticipant", "createdOrder": 30 },
        { "type": "CreateSettlement", "createdOrder": 31 }
      ],
      "expectedTypeOrder": ["DeactivateParticipant", "CreateSettlement"]
    },
    {
      "name": "settlement deletion precedes participant hard deletion",
      "mutations": [
        { "type": "DeleteSettlement", "createdOrder": 40 },
        { "type": "DeleteParticipant", "createdOrder": 41 }
      ],
      "expectedTypeOrder": ["DeleteSettlement", "DeleteParticipant"]
    }
  ]
}
